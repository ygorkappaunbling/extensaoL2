{
	"name": "Controle de tickets",
	"version": "1.2",
	"manifest_version": 3,
	"description": "Registra tickets do suporte do Bling na sua própria planilha do Google Sheets, sem sair do atendimento.",
	"action": {
		"default_popup": "index.html",
		"default_title": "Controle de tickets",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"permissions": [
		"tabs", "identity", "identity.email", "storage", "scripting"
	],
	"host_permissions": ["https://*.bling.com.br/suporte.php*"],
	"background": {
		"service_worker": "scripts/background.js"
	},
	"oauth2": {
		"client_id": "219639291869-bjfqik7pqfa2m54puvjr68s003vs53d0.apps.googleusercontent.com",
		"scopes": [
			"https://www.googleapis.com/auth/spreadsheets"
		]
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
